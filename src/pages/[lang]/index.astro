---
import type { GetStaticPaths } from "astro";
import Cases from "@/components/Cases.astro";
import Contact from "@/components/contact/Contact.astro";
import Experience from "@/components/Experience.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Projects from "@/components/Projects.astro";
import Palette from "@/components/palette/Palette.astro";
import Stack from "@/components/Stack.astro";
import { type Lang, languages } from "@/i18n/ui";
import { resolveLang } from "@/i18n/utils";
import Base from "@/layouts/Base.astro";

export const getStaticPaths = (() =>
	(Object.keys(languages) as Lang[]).map((lang) => ({
		params: { lang },
	}))) satisfies GetStaticPaths;

const lang = resolveLang(Astro.params.lang);
---

<Base lang={lang}>
	<Header lang={lang} />
	<main>
		<Hero lang={lang} />
		<Cases lang={lang} />
		<Projects lang={lang} />
		<Experience lang={lang} />
		<Stack lang={lang} />
		<Contact lang={lang} />
	</main>
	<Footer lang={lang} />
	<Palette lang={lang} />
</Base>
