---
import type { GetStaticPaths } from "astro";
import { type Lang, languages } from "@/i18n/ui";
import { resolveLang } from "@/i18n/utils";
import Base from "@/layouts/Base.astro";

export const getStaticPaths = (() =>
	(Object.keys(languages) as Lang[]).map((lang) => ({
		params: { lang },
	}))) satisfies GetStaticPaths;

const lang = resolveLang(Astro.params.lang);
---

<Base lang={lang}>
	<main class="container-page py-24">
		<p class="eyebrow">WIP</p>
	</main>
</Base>
