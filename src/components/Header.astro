---
import { site } from "@/data/site";
import { type Lang, languages } from "@/i18n/ui";
import { getTranslator, langPath, otherLang } from "@/i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslator(lang);
const alt = otherLang(lang);
const links = [
	{ href: "#cases", label: t("nav.cases") },
	{ href: "#experience", label: t("nav.experience") },
	{ href: "#stack", label: t("nav.stack") },
	{ href: "#contact", label: t("nav.contact") },
];
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-line/60 bg-bg/70 backdrop-blur-md">
	<div class="container-page flex h-14 items-center justify-between gap-4">
		<a href={langPath(lang)} class="font-mono text-sm text-fg" aria-label={site.name}>
			<span class="text-accent">davi</span><span class="text-faint">@</span>quaresma<span
				class="text-faint">:~$</span
			><span class="ml-0.5 inline-block h-4 w-2 translate-y-0.5 animate-blink bg-accent"></span>
		</a>

		<nav class="hidden items-center gap-6 font-mono text-sm text-muted sm:flex">
			{links.map((l) => <a href={l.href} class="transition-colors hover:text-fg">{l.label}</a>)}
		</nav>

		<div class="flex items-center gap-2">
			<button
				type="button"
				data-open-palette
				class="flex items-center gap-2 rounded-md border border-line bg-surface px-2.5 py-1 font-mono text-xs text-muted transition-colors hover:border-line-strong hover:text-fg"
			>
				<span class="hidden sm:inline">{t("nav.palette")}</span>
				<kbd class="rounded bg-surface-2 px-1 text-[10px]">⌘K</kbd>
			</button>
			<a
				href={langPath(alt)}
				hreflang={languages[alt].htmlLang}
				lang={languages[alt].htmlLang}
				class="rounded-md border border-line px-2.5 py-1 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent"
				aria-label={languages[alt].label}
			>
				{languages[alt].short}
			</a>
		</div>
	</div>
</header>

<script>
	for (const btn of document.querySelectorAll("[data-open-palette]")) {
		btn.addEventListener("click", () => window.dispatchEvent(new Event("palette:open")));
	}
</script>
