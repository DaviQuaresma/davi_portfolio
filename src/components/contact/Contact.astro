---
import { site, whatsappUrl } from "@/data/site";
import type { Lang } from "@/i18n/ui";
import { getTranslator } from "@/i18n/utils";
import ContactForm, { type ContactLabels } from "./ContactForm";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslator(lang);

const labels: ContactLabels = {
	name: t("contact.name"),
	email: t("contact.email"),
	company: t("contact.company"),
	message: t("contact.message"),
	submit: t("contact.submit"),
	sending: t("contact.sending"),
	success: t("contact.success"),
	error: t("contact.error"),
	invalid: t("contact.invalid"),
};
---

<section id="contact" class="container-page py-24">
	<div class="grid gap-12 lg:grid-cols-[1fr_1.3fr]">
		<div>
			<p class="eyebrow">{t("contact.eyebrow")}</p>
			<h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{t("contact.title")}</h2>
			<p class="mt-4 max-w-md text-muted">{t("contact.lead")}</p>

			<div class="mt-8 flex flex-col gap-3 font-mono text-sm">
				<a
					href={whatsappUrl(t("contact.whatsappText"))}
					target="_blank"
					rel="noopener"
					class="inline-flex w-fit items-center gap-2 rounded-lg border border-line-strong px-4 py-2 text-fg transition hover:border-[#25d366] hover:text-[#25d366]"
				>
					{t("contact.whatsapp")} ↗
				</a>
				<a href={site.linkedin} target="_blank" rel="noopener" class="w-fit text-muted hover:text-fg">
					LinkedIn ↗
				</a>
				<a href={site.github} target="_blank" rel="noopener" class="w-fit text-muted hover:text-fg">
					GitHub ↗
				</a>
			</div>
		</div>

		<div class="relative rounded-xl border border-line bg-surface p-6 sm:p-8" data-reveal>
			<ContactForm client:visible labels={labels} />
		</div>
	</div>
</section>
