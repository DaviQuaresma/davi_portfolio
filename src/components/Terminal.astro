---
/**
 * Fake terminal that "calls" a personal API. The full response is server-rendered (SEO + no-JS),
 * the typing animation is a progressive enhancement.
 */
interface Props {
	hint: string;
}

const { hint } = Astro.props;

const command = "curl -s https://api.davi.dev/v1/me | jq";
const response = {
	name: "Davi Quaresma",
	role: "Backend & Full-stack Engineer",
	focus: ["financial systems", "data automation", "APIs"],
	stack: {
		backend: ["PHP/Laravel", "Node.js", "Python"],
		data: ["MySQL", "PostgreSQL", "Redis"],
		delivery: ["Docker", "GitHub Actions"],
	},
	open_to: ["backend", "full-stack"],
	available: true,
};

const escapeHtml = (s: string) =>
	s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

/** Minimal JSON highlighter: keys, strings, booleans/numbers. */
const highlight = (line: string) =>
	escapeHtml(line)
		.replace(/^(\s*)"([^"]+)":/, '$1<span class="text-info">"$2"</span>:')
		.replace(/: "([^"]*)"|^(\s*)"([^"]*)"/g, (_m, a, indent, b) =>
			a !== undefined
				? `: <span class="text-accent">"${a}"</span>`
				: `${indent}<span class="text-accent">"${b}"</span>`,
		)
		.replace(/\b(true|false|null|\d+)\b/g, '<span class="text-warn">$1</span>');

const lines = JSON.stringify(response, null, 2).split("\n").map(highlight);
---

<div
	class="overflow-hidden rounded-xl border border-line bg-surface/90 shadow-2xl shadow-black/50 backdrop-blur"
	data-terminal
>
	<div class="flex items-center gap-2 border-b border-line px-4 py-2.5">
		<span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
		<span class="size-2.5 rounded-full bg-[#febc2e]"></span>
		<span class="size-2.5 rounded-full bg-[#28c840]"></span>
		<span class="ml-3 font-mono text-[11px] text-faint">~/davi — zsh</span>
	</div>
	<div class="overflow-x-auto p-4 font-mono text-[12.5px] leading-relaxed sm:p-5 sm:text-[13px]">
		<p class="whitespace-pre text-fg">
			<span class="text-accent">❯</span> <span data-command data-text={command}>{command}</span><span
				data-caret
				class="ml-0.5 hidden h-4 w-2 translate-y-0.5 animate-blink bg-fg"></span>
		</p>
		<p class="mt-1 text-faint" data-line># 200 OK · {hint}</p>
		<pre class="mt-1 text-muted"><code>{lines.map((l) => <span class="block" data-line set:html={l} />)}</code></pre>
	</div>
</div>

<script>
	const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const root = document.querySelector<HTMLElement>("[data-terminal]");

	if (root && !reduce) {
		const cmd = root.querySelector<HTMLElement>("[data-command]");
		const caret = root.querySelector<HTMLElement>("[data-caret]");
		const lines = [...root.querySelectorAll<HTMLElement>("[data-line]")];
		const text = cmd?.dataset.text ?? "";

		for (const l of lines) l.style.opacity = "0";
		if (cmd) cmd.textContent = "";
		caret?.classList.remove("hidden");

		let i = 0;
		const type = () => {
			if (!cmd) return;
			cmd.textContent = text.slice(0, ++i);
			if (i < text.length) {
				setTimeout(type, 28 + Math.random() * 40);
				return;
			}
			setTimeout(() => {
				caret?.classList.add("hidden");
				lines.forEach((l, idx) => {
					setTimeout(() => {
						l.style.transition = "opacity .25s";
						l.style.opacity = "1";
					}, idx * 45);
				});
			}, 350);
		};
		setTimeout(type, 500);
	}
</script>
