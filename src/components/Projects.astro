---
import { projects } from "@/data/projects";
import type { Lang } from "@/i18n/ui";
import { getTranslator } from "@/i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslator(lang);
---

<section id="projects" class="container-page py-24">
	<p class="eyebrow">{t("projects.eyebrow")}</p>
	<h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{t("projects.title")}</h2>

	<ul class="mt-12 grid gap-4 md:grid-cols-3">
		{
			projects.map((p) => (
				<li
					class="group flex flex-col rounded-xl border border-line bg-surface/70 p-6 transition-colors hover:border-line-strong"
					data-reveal
				>
					{p.context && <p class="font-mono text-[11px] text-faint">{p.context[lang]}</p>}
					<h3 class="mt-2 text-lg font-semibold transition-colors group-hover:text-accent">
						{p.title[lang]}
					</h3>
					<p class="mt-3 text-sm leading-relaxed text-muted">{p.description[lang]}</p>

					<ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Stack">
						{p.stack.map((s) => (
							<li class="chip">{s}</li>
						))}
					</ul>

					<div class="mt-auto flex gap-4 pt-6 font-mono text-xs">
						{p.links.map((l) => (
							<a
								href={l.href}
								target="_blank"
								rel="noopener"
								class="text-muted transition-colors hover:text-fg"
								aria-label={`${p.title[lang]} — ${l.label}`}
							>
								{l.label} ↗
							</a>
						))}
					</div>
				</li>
			))
		}
	</ul>
</section>
