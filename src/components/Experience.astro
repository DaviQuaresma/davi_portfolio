---
import { experience } from "@/data/experience";
import type { Lang } from "@/i18n/ui";
import { getTranslator } from "@/i18n/utils";
import { formatMonth } from "@/lib/dates";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslator(lang);
const fmt = (ym: string) => formatMonth(lang, ym);
const period = (start: string, end?: string) =>
	`${fmt(start)} — ${end ? fmt(end) : t("experience.present")}`;
---

<section id="experience" class="container-page py-24">
	<p class="eyebrow">{t("experience.eyebrow")}</p>
	<h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{t("experience.title")}</h2>

	<ol class="mt-12 space-y-4">
		{
			experience.map((job) => (
				<li class="grid gap-6 rounded-xl border border-line bg-surface/70 p-6 sm:p-8 lg:grid-cols-[16rem_1fr]" data-reveal>
					<div>
						<h3 class="font-semibold">{job.company}</h3>
						<p class="mt-1 font-mono text-xs text-faint">{job.location[lang]}</p>
						<ul class="mt-4 flex flex-wrap gap-1.5">
							{job.tags.map((tag) => (
								<li class="chip">{tag}</li>
							))}
						</ul>
					</div>

					<ol class="relative space-y-8 border-l border-line pl-6">
						{job.roles.map((role, i) => (
							<li class="relative">
								<span
									class:list={[
										"absolute top-1.5 -left-[29px] size-2.5 rounded-full border-2 border-bg",
										!role.end ? "bg-accent shadow-[0_0_12px_var(--color-accent)]" : "bg-line-strong",
									]}
									aria-hidden="true"
								/>
								<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
									<p class="font-medium">{role.title[lang]}</p>
									{i === 0 && job.roles.length > 1 && (
										<span class="rounded bg-accent-dim px-1.5 py-0.5 font-mono text-[10px] text-accent uppercase">
											{t("experience.promoted")}
										</span>
									)}
								</div>
								<p class="mt-1 font-mono text-xs text-muted">{period(role.start, role.end)}</p>
								<ul class="mt-3 space-y-1.5 text-[15px] text-muted">
									{role.bullets.map((b) => (
										<li class="flex gap-3">
											<span class="mt-[0.6em] h-px w-2.5 shrink-0 bg-faint" aria-hidden="true" />
											<span>{b[lang]}</span>
										</li>
									))}
								</ul>
							</li>
						))}
					</ol>
				</li>
			))
		}
	</ol>
</section>
