---
import "@/styles/global.css";
import { degrees, studyAreas } from "@/data/academic";
import { site } from "@/data/site";
import { type Lang, languages } from "@/i18n/ui";
import { getTranslator, langPath } from "@/i18n/utils";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslator(lang);
const title = t("meta.title");
const description = t("meta.description");
const canonical = new URL(langPath(lang), Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang={languages[lang].htmlLang} class="no-js">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>document.documentElement.classList.remove("no-js");</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#08090b" />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		{
			(Object.keys(languages) as Lang[]).map((l) => (
				<link rel="alternate" hreflang={languages[l].htmlLang} href={new URL(langPath(l), Astro.site)} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content={languages[lang].ogLocale} />
		<meta name="twitter:card" content="summary_large_image" />

		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "Person",
				name: "Davi Quaresma",
				jobTitle: "Backend & Full-stack Engineer",
				url: Astro.site?.toString(),
				sameAs: [site.github, site.linkedin],
				alumniOf: degrees.map((d) => ({ "@type": "CollegeOrUniversity", name: d.institution })),
				knowsLanguage: ["pt-BR", "en"],
				knowsAbout: studyAreas.map((a) => a.en),
			})}
		/>
	</head>
	<body class="min-h-dvh">
		<slot />

		<script>
			// Reveal-on-scroll: progressive enhancement, content is visible without JS.
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add("is-visible");
							io.unobserve(entry.target);
						}
					}
				},
				{ rootMargin: "0px 0px -10% 0px" },
			);
			for (const el of document.querySelectorAll("[data-reveal]")) io.observe(el);
		</script>
	</body>
</html>
